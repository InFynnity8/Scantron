{
  "cli": {
    "version": ">= 16.13.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_OMR_API_URL": "https://scantron-omr.onrender.com",
        "EXPO_PUBLIC_AUTH_API_URL": "https://scantron-backend.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_OMR_API_URL": "https://scantron-omr.onrender.com",
        "EXPO_PUBLIC_AUTH_API_URL": "https://scantron-backend.onrender.com"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_OMR_API_URL": "https://scantron-omr.onrender.com",
        "EXPO_PUBLIC_AUTH_API_URL": "https://scantron-backend.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
