{
  "expo": {
    "name": "Scantron",
    "slug": "scantron",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/scantron.png",
    "scheme": "scantron",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infynnity.scantron",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scantron uses the camera to read and grade answer sheets.",
        "NSPhotoLibraryUsageDescription": "Choose a photo of an answer sheet to grade."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/scantron.png",
        "backgroundColor": "#0E1015"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.scan",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/scantron.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scantron uses the camera to read and grade answer sheets.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/scantron.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E1015"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of an answer sheet to grade.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5b38d20-09c4-4b90-9f90-77f73ac6d856"
      }
    },
    "owner": "fynb",
    "backgroundColor": "#0E1015"
  }
}
